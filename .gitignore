.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
# per-face bulk scans are fetched, not committed (provenance lives in face.yaml)
faces/*/specimens/*.jp2
faces/*/specimens/*.zip
.DS_Store
# books/: whole-book scans and OCR are fetched by `shelve`, not committed
books/*/*.zip
books/*/jp2/
books/*/ocr/
books/*/sheets/
# per-leaf surveys are rebuilt by `catalog`; catalog.json (every band's position) anchors the readings.
books/*/survey/
# raw answers of the model readers; books/<id>/reader.jsonl is the committed record
books/.reader-cache/

# Vercel link (the project root directory is website/)
.vercel

# API keys for model readings (OpenRouter); never committed
.env
